# Shown to clients by the agent
# BUSINESS_NAME=

# Square: SQUARE_MODE=fake uses an in-memory shop (no Square account needed);
# live uses SQUARE_ENVIRONMENT (sandbox first, production when ready)
SQUARE_MODE=fake
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Business timezone used for all slot display and parsing
BUSINESS_TIMEZONE=America/Los_Angeles

# Model: bedrock (Claude on AWS) or anthropic (Anthropic API key)
MODEL_PROVIDER=bedrock
# AWS CLI profile to use (from `aws configure sso`); empty uses your default credentials
AWS_PROFILE=
AWS_REGION=us-west-2
# Empty uses Strands' default Claude model on Bedrock
BEDROCK_MODEL_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-5-5

# Twilio (Phase 2)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
BARBER_PHONE_NUMBER=
